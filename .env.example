# Copy to .env and set both passwords. compose and etl-bench read these variables.
# SQL Server needs a strong sa password: 8+ characters with upper, lower, digit and symbol.
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=Change-me-1
MSSQL_DATABASE=ledger

# Standard libpq variables for the PostgreSQL target.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=etl
PGPASSWORD=change-me
PGDATABASE=warehouse
